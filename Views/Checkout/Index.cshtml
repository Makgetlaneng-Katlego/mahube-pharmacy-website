@model CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}

<h2>Checkout</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row">
    <div class="col-md-7">
        <h3>Order Summary</h3>
        <table class="table">
            <thead><tr><th>Product</th><th>Qty</th><th>Price</th><th>Total</th></tr></thead>
            <tbody>
            @foreach (var i in Model.Items)
            {
                <tr>
                    <td>@i.Product.ProductName</td>
                    <td>@i.Quantity</td>
                    <td>R @i.Product.Price.ToString("F2")</td>
                    <td>R @i.LineTotal.ToString("F2")</td>
                </tr>
            }
            </tbody>
            <tfoot>
                <tr><td colspan="3">Subtotal</td><td>R @Model.Subtotal.ToString("F2")</td></tr>
                <tr><td colspan="3">Service Fee</td><td>R @Model.ServiceFee.ToString("F2")</td></tr>
                <tr class="fw-bold">
                    <td colspan="3">Total</td>
                    <td>R @Model.Total.ToString("F2")</td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="col-md-5">
        <h3>Delivery Address</h3>

        <form asp-action="PlaceOrder" method="post">
            @Html.AntiForgeryToken()

            @if (Model.Addresses.Any())
            {
                foreach (var a in Model.Addresses)
                {
                    <label class="d-block border rounded p-2 mb-2">
                        <input type="radio" name="selectedAddressId" value="@a.AddressId"
                               @(a.AddressId == Model.SelectedAddressId ? "checked" : "") />
                        <strong>@a.AddressName</strong><br />
                        @a.StreetAddress, @a.City, @a.Province, @a.PostalCode
                        @if (!string.IsNullOrEmpty(a.DeliveryInstruction))
                        {
                            <br /><em class="small">@a.DeliveryInstruction</em>
                        }
                    </label>
                }
                <a asp-controller="Address" asp-action="Create"
                   asp-route-returnUrl="/Checkout" class="d-inline-block mb-3">
                    + Add another address
                </a>
            }
            else
            {
                <p>
                    You have no saved addresses.
                    <a asp-controller="Address" asp-action="Create"
                       asp-route-returnUrl="/Checkout">Add one</a> to continue.
                </p>
            }

            <div class="mt-3">
                <h5>Payment</h5>
                <p><strong>Cash on Delivery</strong></p>
            </div>

            <button type="submit" class="btn btn-primary w-100"
                    @(Model.Addresses.Any() ? "" : "disabled")>
                Place Order — R @Model.Total.ToString("F2")
            </button>
        </form>
    </div>
</div>